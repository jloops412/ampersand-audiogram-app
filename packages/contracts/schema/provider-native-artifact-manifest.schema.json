{
  "additionalProperties": false,
  "description": "Audit pointer for provider-native output kept outside the Ampersand schema.",
  "properties": {
    "adapter_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Adapter Version",
      "type": "string"
    },
    "artifact_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "contains_transcript_text": {
      "default": false,
      "title": "Contains Transcript Text",
      "type": "boolean"
    },
    "mime_type": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Mime Type",
      "type": "string"
    },
    "provider_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Provider Id",
      "type": "string"
    },
    "provider_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Provider Version",
      "type": "string"
    },
    "redaction_summary": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Redaction Summary",
      "type": "string"
    },
    "relative_path": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Relative Path",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "artifact_id",
    "provider_id",
    "provider_version",
    "adapter_id",
    "adapter_version",
    "relative_path",
    "sha256",
    "size_bytes",
    "mime_type",
    "redaction_summary"
  ],
  "title": "ProviderNativeArtifactManifest",
  "type": "object"
}
