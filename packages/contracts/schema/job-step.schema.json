{
  "$defs": {
    "JobStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "bypassed"
      ],
      "title": "JobStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "default": 1,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "failure_code": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "idempotency_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "implementation_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Implementation Version",
      "type": "string"
    },
    "input_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Manifest Hash",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Metrics",
      "type": "object"
    },
    "output_manifest_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Output Manifest Ids",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/JobStatus"
    },
    "step_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Step Id",
      "type": "string"
    },
    "step_key": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Step Key",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "step_id",
    "run_id",
    "step_key",
    "implementation_version",
    "input_manifest_hash",
    "idempotency_key",
    "status"
  ],
  "title": "JobStep",
  "type": "object"
}
