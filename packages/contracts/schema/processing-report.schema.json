{
  "$defs": {
    "LoudnessMeasurement": {
      "additionalProperties": false,
      "properties": {
        "backend_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Backend Version",
          "type": "string"
        },
        "integrated_lufs": {
          "title": "Integrated Lufs",
          "type": "number"
        },
        "loudness_range_lu": {
          "minimum": 0.0,
          "title": "Loudness Range Lu",
          "type": "number"
        },
        "measurement_backend": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Measurement Backend",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "threshold_lufs": {
          "title": "Threshold Lufs",
          "type": "number"
        },
        "true_peak_dbtp": {
          "title": "True Peak Dbtp",
          "type": "number"
        }
      },
      "required": [
        "integrated_lufs",
        "true_peak_dbtp",
        "loudness_range_lu",
        "threshold_lufs",
        "measurement_backend",
        "backend_version"
      ],
      "title": "LoudnessMeasurement",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Artifact Sha256",
      "type": "object"
    },
    "cleanup_plan_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Cleanup Plan Id",
      "type": "string"
    },
    "cleanup_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cleanup Plan Sha256",
      "type": "string"
    },
    "decisions": {
      "items": {
        "type": "string"
      },
      "title": "Decisions",
      "type": "array"
    },
    "engine_build_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Engine Build Id",
      "type": "string"
    },
    "external_api_cost_usd": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "External Api Cost Usd",
      "type": "number"
    },
    "gain_envelope_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gain Envelope Id"
    },
    "leveler_statistics_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Leveler Statistics Id"
    },
    "loudness_after": {
      "$ref": "#/$defs/LoudnessMeasurement"
    },
    "loudness_before": {
      "$ref": "#/$defs/LoudnessMeasurement"
    },
    "privacy_summary": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Privacy Summary",
      "type": "string"
    },
    "processing_report_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Processing Report Id",
      "type": "string"
    },
    "production_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Production Id",
      "type": "string"
    },
    "recipe_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Recipe Version Id",
      "type": "string"
    },
    "reproducibility_summary": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reproducibility Summary",
      "type": "string"
    },
    "resolved_settings_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Resolved Settings Id",
      "type": "string"
    },
    "resolved_settings_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resolved Settings Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "step_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Step Ids",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "processing_report_id",
    "production_id",
    "run_id",
    "source_asset_id",
    "recipe_version_id",
    "resolved_settings_id",
    "resolved_settings_sha256",
    "engine_build_id",
    "status",
    "loudness_before",
    "loudness_after",
    "cleanup_plan_id",
    "cleanup_plan_sha256",
    "step_ids",
    "decisions",
    "artifact_sha256",
    "privacy_summary",
    "reproducibility_summary"
  ],
  "title": "ProcessingReport",
  "type": "object"
}
