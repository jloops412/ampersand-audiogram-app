{
  "$defs": {
    "SemanticRegion": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "content_label": {
          "enum": [
            "unknown",
            "speech",
            "silence",
            "music",
            "ambience",
            "noise",
            "mixed"
          ],
          "title": "Content Label",
          "type": "string"
        },
        "end_us": {
          "minimum": 0,
          "title": "End Us",
          "type": "integer"
        },
        "music_probability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Music Probability"
        },
        "observations": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Observations",
          "type": "object"
        },
        "protected": {
          "default": true,
          "title": "Protected",
          "type": "boolean"
        },
        "provider_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Provider Refs",
          "type": "array"
        },
        "region_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "title": "Region Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "silence_probability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Silence Probability"
        },
        "speech_probability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speech Probability"
        },
        "start_us": {
          "minimum": 0,
          "title": "Start Us",
          "type": "integer"
        }
      },
      "required": [
        "region_id",
        "start_us",
        "end_us",
        "content_label",
        "confidence"
      ],
      "title": "SemanticRegion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "duration_us": {
      "minimum": 0,
      "title": "Duration Us",
      "type": "integer"
    },
    "provider_native_artifact_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Provider Native Artifact Ids",
      "type": "array"
    },
    "regions": {
      "items": {
        "$ref": "#/$defs/SemanticRegion"
      },
      "title": "Regions",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_map_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Semantic Map Id",
      "type": "string"
    },
    "source_asset_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "semantic_map_id",
    "source_asset_id",
    "duration_us",
    "regions"
  ],
  "title": "SemanticMap",
  "type": "object"
}
