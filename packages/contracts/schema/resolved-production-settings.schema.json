{
  "$defs": {
    "AudiogramSettings": {
      "additionalProperties": false,
      "description": "Versioned deterministic controls shared by Studio and the server renderer.",
      "properties": {
        "aspect_ratio": {
          "default": "square",
          "enum": [
            "square",
            "feed_portrait",
            "portrait",
            "landscape"
          ],
          "title": "Aspect Ratio",
          "type": "string"
        },
        "background_color": {
          "default": "#111718",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Background Color",
          "type": "string"
        },
        "background_dim": {
          "default": 0.34,
          "maximum": 0.85,
          "minimum": 0.0,
          "title": "Background Dim",
          "type": "number"
        },
        "background_fit": {
          "default": "cover",
          "enum": [
            "cover",
            "contain"
          ],
          "title": "Background Fit",
          "type": "string"
        },
        "background_mode": {
          "default": "color",
          "enum": [
            "color",
            "artwork",
            "video"
          ],
          "title": "Background Mode",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "frame_rate": {
          "default": 30,
          "enum": [
            24,
            30,
            60
          ],
          "title": "Frame Rate",
          "type": "integer"
        },
        "headline": {
          "default": "",
          "maxLength": 160,
          "title": "Headline",
          "type": "string"
        },
        "headline_size_percent": {
          "default": 4.8,
          "maximum": 10.0,
          "minimum": 2.0,
          "title": "Headline Size Percent",
          "type": "number"
        },
        "render_quality": {
          "default": "standard",
          "enum": [
            "draft",
            "standard",
            "high"
          ],
          "title": "Render Quality",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "spec_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Spec Version",
          "type": "string"
        },
        "subtitle": {
          "default": "",
          "maxLength": 160,
          "title": "Subtitle",
          "type": "string"
        },
        "subtitle_size_percent": {
          "default": 2.7,
          "maximum": 6.0,
          "minimum": 1.0,
          "title": "Subtitle Size Percent",
          "type": "number"
        },
        "text_align": {
          "default": "center",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "Text Align",
          "type": "string"
        },
        "text_color": {
          "default": "#f4f1ea",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Text Color",
          "type": "string"
        },
        "waveform_color": {
          "default": "#e1b977",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Waveform Color",
          "type": "string"
        },
        "waveform_height_percent": {
          "default": 30,
          "maximum": 60,
          "minimum": 10,
          "title": "Waveform Height Percent",
          "type": "integer"
        },
        "waveform_opacity": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.1,
          "title": "Waveform Opacity",
          "type": "number"
        },
        "waveform_position": {
          "default": "center",
          "enum": [
            "top",
            "center",
            "bottom"
          ],
          "title": "Waveform Position",
          "type": "string"
        },
        "waveform_scale": {
          "default": "sqrt",
          "enum": [
            "linear",
            "sqrt",
            "cbrt",
            "log"
          ],
          "title": "Waveform Scale",
          "type": "string"
        },
        "waveform_style": {
          "default": "mirrored",
          "enum": [
            "line",
            "mirrored",
            "bars",
            "dots"
          ],
          "title": "Waveform Style",
          "type": "string"
        },
        "waveform_width_percent": {
          "default": 82,
          "maximum": 100,
          "minimum": 40,
          "title": "Waveform Width Percent",
          "type": "integer"
        }
      },
      "title": "AudiogramSettings",
      "type": "object"
    },
    "CleanupSettings": {
      "additionalProperties": false,
      "description": "Deterministic spoken-word cleanup controls admitted for the V1 beta.",
      "properties": {
        "compression": {
          "default": "off",
          "enum": [
            "off",
            "gentle",
            "balanced",
            "firm"
          ],
          "title": "Compression",
          "type": "string"
        },
        "declip": {
          "default": false,
          "title": "Declip",
          "type": "boolean"
        },
        "deesser": {
          "default": "off",
          "enum": [
            "off",
            "light",
            "balanced",
            "strong"
          ],
          "title": "Deesser",
          "type": "string"
        },
        "hum_reduction": {
          "default": "off",
          "enum": [
            "off",
            "50hz",
            "60hz"
          ],
          "title": "Hum Reduction",
          "type": "string"
        },
        "mode": {
          "default": "manual",
          "enum": [
            "smart",
            "manual"
          ],
          "title": "Mode",
          "type": "string"
        },
        "noise_gate": {
          "default": "off",
          "enum": [
            "off",
            "light",
            "balanced"
          ],
          "title": "Noise Gate",
          "type": "string"
        },
        "noise_reduction": {
          "default": "off",
          "enum": [
            "off",
            "light",
            "balanced",
            "strong"
          ],
          "title": "Noise Reduction",
          "type": "string"
        },
        "rumble_filter": {
          "default": false,
          "title": "Rumble Filter",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "voice_enhancement": {
          "default": "off",
          "enum": [
            "off",
            "natural",
            "warm",
            "presence"
          ],
          "title": "Voice Enhancement",
          "type": "string"
        }
      },
      "title": "CleanupSettings",
      "type": "object"
    },
    "ExportSettings": {
      "additionalProperties": false,
      "description": "Delivery choices that map directly to admitted encoder paths.",
      "properties": {
        "mp3": {
          "default": true,
          "title": "Mp3",
          "type": "boolean"
        },
        "mp3_bitrate_kbps": {
          "default": 192,
          "enum": [
            128,
            160,
            192,
            256,
            320
          ],
          "title": "Mp3 Bitrate Kbps",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "wav": {
          "default": true,
          "title": "Wav",
          "type": "boolean"
        }
      },
      "title": "ExportSettings",
      "type": "object"
    },
    "MasteringSettings": {
      "additionalProperties": false,
      "description": "Safe, executable mastering controls exposed by the private beta.",
      "properties": {
        "max_true_peak_dbtp": {
          "maximum": -1.0,
          "minimum": -3.0,
          "title": "Max True Peak Dbtp",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_integrated_lufs": {
          "maximum": -14.0,
          "minimum": -24.0,
          "title": "Target Integrated Lufs",
          "type": "number"
        },
        "target_loudness_range_lu": {
          "maximum": 30.0,
          "minimum": 5.0,
          "title": "Target Loudness Range Lu",
          "type": "number"
        }
      },
      "required": [
        "target_integrated_lufs",
        "max_true_peak_dbtp",
        "target_loudness_range_lu"
      ],
      "title": "MasteringSettings",
      "type": "object"
    },
    "OutputMetadataSettings": {
      "additionalProperties": false,
      "description": "Portable delivery tags written by FFmpeg without adding a metadata dependency.",
      "properties": {
        "album": {
          "default": "",
          "maxLength": 160,
          "title": "Album",
          "type": "string"
        },
        "artist": {
          "default": "",
          "maxLength": 160,
          "title": "Artist",
          "type": "string"
        },
        "comment": {
          "default": "",
          "maxLength": 512,
          "title": "Comment",
          "type": "string"
        },
        "copyright": {
          "default": "",
          "maxLength": 256,
          "title": "Copyright",
          "type": "string"
        },
        "date": {
          "default": "",
          "maxLength": 40,
          "title": "Date",
          "type": "string"
        },
        "genre": {
          "default": "",
          "maxLength": 80,
          "title": "Genre",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "track_number": {
          "default": "",
          "maxLength": 32,
          "title": "Track Number",
          "type": "string"
        }
      },
      "title": "OutputMetadataSettings",
      "type": "object"
    },
    "ProductionSettings": {
      "additionalProperties": false,
      "description": "Complete executable settings for one beta production.",
      "properties": {
        "audiogram": {
          "$ref": "#/$defs/AudiogramSettings"
        },
        "cleanup": {
          "$ref": "#/$defs/CleanupSettings"
        },
        "export": {
          "$ref": "#/$defs/ExportSettings"
        },
        "mastering": {
          "$ref": "#/$defs/MasteringSettings"
        },
        "metadata": {
          "$ref": "#/$defs/OutputMetadataSettings"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "mastering",
        "export"
      ],
      "title": "ProductionSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fully expanded, immutable settings snapshot attached to a run.",
  "properties": {
    "field_provenance": {
      "additionalProperties": {
        "enum": [
          "recipe",
          "template",
          "run_override"
        ],
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "cleanup.mode",
          "cleanup.noise_reduction",
          "cleanup.rumble_filter",
          "cleanup.hum_reduction",
          "cleanup.declip",
          "cleanup.noise_gate",
          "cleanup.deesser",
          "cleanup.voice_enhancement",
          "cleanup.compression",
          "mastering.target_integrated_lufs",
          "mastering.max_true_peak_dbtp",
          "mastering.target_loudness_range_lu",
          "metadata.artist",
          "metadata.album",
          "metadata.genre",
          "metadata.date",
          "metadata.comment",
          "metadata.copyright",
          "metadata.track_number",
          "audiogram.enabled",
          "audiogram.spec_version",
          "audiogram.aspect_ratio",
          "audiogram.waveform_style",
          "audiogram.waveform_scale",
          "audiogram.waveform_position",
          "audiogram.waveform_width_percent",
          "audiogram.waveform_height_percent",
          "audiogram.waveform_opacity",
          "audiogram.background_mode",
          "audiogram.background_fit",
          "audiogram.background_dim",
          "audiogram.background_color",
          "audiogram.waveform_color",
          "audiogram.text_color",
          "audiogram.text_align",
          "audiogram.headline_size_percent",
          "audiogram.subtitle_size_percent",
          "audiogram.headline",
          "audiogram.subtitle",
          "audiogram.frame_rate",
          "audiogram.render_quality",
          "export.wav",
          "export.mp3",
          "export.mp3_bitrate_kbps"
        ]
      },
      "title": "Field Provenance",
      "type": "object"
    },
    "intent": {
      "enum": [
        "podcast",
        "natural_voice",
        "broadcast",
        "social_voice"
      ],
      "title": "Intent",
      "type": "string"
    },
    "recipe_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Recipe Version Id",
      "type": "string"
    },
    "resolved_settings_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Resolved Settings Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "settings": {
      "$ref": "#/$defs/ProductionSettings"
    },
    "settings_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Settings Sha256",
      "type": "string"
    },
    "template_version_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Version Id"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "resolved_settings_id",
    "recipe_version_id",
    "intent",
    "settings",
    "settings_sha256",
    "field_provenance"
  ],
  "title": "ResolvedProductionSettings",
  "type": "object"
}
