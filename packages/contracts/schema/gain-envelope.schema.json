{
  "$defs": {
    "GainPoint": {
      "additionalProperties": false,
      "properties": {
        "at_us": {
          "minimum": 0,
          "title": "At Us",
          "type": "integer"
        },
        "gain_db": {
          "maximum": 24.0,
          "minimum": -60.0,
          "title": "Gain Db",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "at_us",
        "gain_db"
      ],
      "title": "GainPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "duration_us": {
      "minimum": 0,
      "title": "Duration Us",
      "type": "integer"
    },
    "gain_envelope_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Gain Envelope Id",
      "type": "string"
    },
    "interpolation": {
      "const": "linear",
      "default": "linear",
      "title": "Interpolation",
      "type": "string"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/GainPoint"
      },
      "title": "Points",
      "type": "array"
    },
    "purpose": {
      "enum": [
        "unity_baseline",
        "adaptive_leveler"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "gain_envelope_id",
    "run_id",
    "duration_us",
    "points",
    "purpose"
  ],
  "title": "GainEnvelope",
  "type": "object"
}
