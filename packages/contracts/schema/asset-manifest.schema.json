{
  "$defs": {
    "AssetKind": {
      "enum": [
        "source",
        "background_artwork",
        "canonical_audio",
        "waveform",
        "master_wav",
        "master_mp3",
        "audiogram_mp4",
        "manifest"
      ],
      "title": "AssetKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Asset Id",
      "type": "string"
    },
    "created_by_step_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created By Step Id"
    },
    "filename": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Filename",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/AssetKind"
    },
    "mime_type": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Mime Type",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Provenance",
      "type": "object"
    },
    "retention_class": {
      "default": "local_fixture",
      "maxLength": 64,
      "minLength": 1,
      "title": "Retention Class",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "source_asset_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Asset Id"
    },
    "uri": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Uri",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "kind",
    "uri",
    "sha256",
    "size_bytes",
    "mime_type",
    "filename"
  ],
  "title": "AssetManifest",
  "type": "object"
}
