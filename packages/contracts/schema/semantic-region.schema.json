{
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "content_label": {
      "enum": [
        "unknown",
        "speech",
        "silence",
        "music",
        "ambience",
        "noise",
        "mixed"
      ],
      "title": "Content Label",
      "type": "string"
    },
    "end_us": {
      "minimum": 0,
      "title": "End Us",
      "type": "integer"
    },
    "music_probability": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Music Probability"
    },
    "observations": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Observations",
      "type": "object"
    },
    "protected": {
      "default": true,
      "title": "Protected",
      "type": "boolean"
    },
    "provider_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Provider Refs",
      "type": "array"
    },
    "region_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Region Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "silence_probability": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Silence Probability"
    },
    "speech_probability": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speech Probability"
    },
    "start_us": {
      "minimum": 0,
      "title": "Start Us",
      "type": "integer"
    }
  },
  "required": [
    "region_id",
    "start_us",
    "end_us",
    "content_label",
    "confidence"
  ],
  "title": "SemanticRegion",
  "type": "object"
}
