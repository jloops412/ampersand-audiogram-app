{
  "$defs": {
    "ProcessingEligibility": {
      "enum": [
        "eligible",
        "protect",
        "no_op"
      ],
      "title": "ProcessingEligibility",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_speaker": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Speaker"
    },
    "active_speaker_confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Speaker Confidence"
    },
    "ambience_probability": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ambience Probability"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "conflict_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Conflict Ids",
      "type": "array"
    },
    "content_label": {
      "enum": [
        "unknown",
        "speech",
        "silence",
        "music",
        "ambience",
        "noise",
        "mixed"
      ],
      "title": "Content Label",
      "type": "string"
    },
    "end_us": {
      "minimum": 0,
      "title": "End Us",
      "type": "integer"
    },
    "music_probability": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Music Probability"
    },
    "noise_probability": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Noise Probability"
    },
    "observation_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Observation Ids",
      "type": "array"
    },
    "observations": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Observations",
      "type": "object"
    },
    "overlap_probability": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Overlap Probability"
    },
    "processing_eligibility": {
      "$ref": "#/$defs/ProcessingEligibility",
      "default": "protect"
    },
    "protected": {
      "default": true,
      "title": "Protected",
      "type": "boolean"
    },
    "provider_refs": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Provider Refs",
      "type": "array"
    },
    "region_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Region Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "silence_probability": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Silence Probability"
    },
    "speech_probability": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speech Probability"
    },
    "start_us": {
      "minimum": 0,
      "title": "Start Us",
      "type": "integer"
    }
  },
  "required": [
    "region_id",
    "start_us",
    "end_us",
    "content_label",
    "confidence"
  ],
  "title": "SemanticRegion",
  "type": "object"
}
