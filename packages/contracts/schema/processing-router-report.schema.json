{
  "$defs": {
    "ProcessingRouteDecision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "bypass",
            "protect",
            "deterministic_filter",
            "denoise",
            "level",
            "final_master"
          ],
          "title": "Action",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "decision_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "title": "Decision Id",
          "type": "string"
        },
        "fallback_processor_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Processor Id"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "planning_only": {
          "const": true,
          "default": true,
          "title": "Planning Only",
          "type": "boolean"
        },
        "processing_region_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "title": "Processing Region Id",
          "type": "string"
        },
        "processor_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "title": "Processor Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "title": "Reason Code",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_region_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Semantic Region Ids",
          "type": "array"
        },
        "warning_codes": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
            "type": "string"
          },
          "title": "Warning Codes",
          "type": "array"
        }
      },
      "required": [
        "decision_id",
        "processing_region_id",
        "semantic_region_ids",
        "action",
        "processor_id",
        "reason_code",
        "reason",
        "confidence"
      ],
      "title": "ProcessingRouteDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithm_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Algorithm Version",
      "type": "string"
    },
    "bypassed_region_count": {
      "minimum": 0,
      "title": "Bypassed Region Count",
      "type": "integer"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/ProcessingRouteDecision"
      },
      "minItems": 1,
      "title": "Decisions",
      "type": "array"
    },
    "denoise_region_count": {
      "minimum": 0,
      "title": "Denoise Region Count",
      "type": "integer"
    },
    "deterministic_filter_region_count": {
      "minimum": 0,
      "title": "Deterministic Filter Region Count",
      "type": "integer"
    },
    "external_api_cost_usd": {
      "const": 0,
      "default": 0,
      "title": "External Api Cost Usd",
      "type": "integer"
    },
    "leveler_region_count": {
      "minimum": 0,
      "title": "Leveler Region Count",
      "type": "integer"
    },
    "override_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Override Ids",
      "type": "array"
    },
    "planning_only": {
      "const": true,
      "default": true,
      "title": "Planning Only",
      "type": "boolean"
    },
    "processing_plan_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Processing Plan Id",
      "type": "string"
    },
    "processing_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Processing Plan Sha256",
      "type": "string"
    },
    "processing_router_report_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Processing Router Report Id",
      "type": "string"
    },
    "production_audio_changed": {
      "const": false,
      "default": false,
      "title": "Production Audio Changed",
      "type": "boolean"
    },
    "protected_region_count": {
      "minimum": 0,
      "title": "Protected Region Count",
      "type": "integer"
    },
    "recipe_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Recipe Version Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_map_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Semantic Map Id",
      "type": "string"
    },
    "settings_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Settings Id",
      "type": "string"
    },
    "settings_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Settings Sha256",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "processing_router_report_id",
    "run_id",
    "semantic_map_id",
    "recipe_version_id",
    "settings_id",
    "settings_sha256",
    "algorithm_version",
    "processing_plan_id",
    "processing_plan_sha256",
    "decisions",
    "protected_region_count",
    "bypassed_region_count",
    "deterministic_filter_region_count",
    "denoise_region_count",
    "leveler_region_count"
  ],
  "title": "ProcessingRouterReport",
  "type": "object"
}
