{
  "$defs": {
    "AudiogramSettings": {
      "additionalProperties": false,
      "description": "Versioned deterministic controls shared by Studio and the server renderer.",
      "properties": {
        "accent_color": {
          "default": "#e1b977",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Accent Color",
          "type": "string"
        },
        "aspect_ratio": {
          "default": "square",
          "enum": [
            "square",
            "feed_portrait",
            "portrait",
            "landscape"
          ],
          "title": "Aspect Ratio",
          "type": "string"
        },
        "background_blur": {
          "default": 0,
          "maximum": 30,
          "minimum": 0,
          "title": "Background Blur",
          "type": "integer"
        },
        "background_color": {
          "default": "#111718",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Background Color",
          "type": "string"
        },
        "background_dim": {
          "default": 0.08,
          "maximum": 0.85,
          "minimum": 0.0,
          "title": "Background Dim",
          "type": "number"
        },
        "background_fit": {
          "default": "cover",
          "enum": [
            "cover",
            "contain"
          ],
          "title": "Background Fit",
          "type": "string"
        },
        "background_mode": {
          "default": "gradient",
          "enum": [
            "color",
            "gradient",
            "radial",
            "artwork",
            "video"
          ],
          "title": "Background Mode",
          "type": "string"
        },
        "background_vignette": {
          "default": 0.45,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Background Vignette",
          "type": "number"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "font_family": {
          "default": "sans",
          "enum": [
            "sans",
            "serif",
            "mono"
          ],
          "title": "Font Family",
          "type": "string"
        },
        "frame_rate": {
          "default": 30,
          "enum": [
            24,
            30,
            60
          ],
          "title": "Frame Rate",
          "type": "integer"
        },
        "headline": {
          "default": "",
          "maxLength": 160,
          "title": "Headline",
          "type": "string"
        },
        "headline_size_percent": {
          "default": 4.8,
          "maximum": 10.0,
          "minimum": 2.0,
          "title": "Headline Size Percent",
          "type": "number"
        },
        "render_quality": {
          "default": "standard",
          "enum": [
            "draft",
            "standard",
            "high"
          ],
          "title": "Render Quality",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "spec_version": {
          "default": "1.1",
          "enum": [
            "1.0",
            "1.1"
          ],
          "title": "Spec Version",
          "type": "string"
        },
        "subtitle": {
          "default": "",
          "maxLength": 160,
          "title": "Subtitle",
          "type": "string"
        },
        "subtitle_size_percent": {
          "default": 2.7,
          "maximum": 6.0,
          "minimum": 1.0,
          "title": "Subtitle Size Percent",
          "type": "number"
        },
        "text_align": {
          "default": "center",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "Text Align",
          "type": "string"
        },
        "text_color": {
          "default": "#f8f4ec",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Text Color",
          "type": "string"
        },
        "text_panel": {
          "default": "shadow",
          "enum": [
            "none",
            "shadow",
            "glass",
            "accent"
          ],
          "title": "Text Panel",
          "type": "string"
        },
        "text_position": {
          "default": "top",
          "enum": [
            "top",
            "center",
            "bottom"
          ],
          "title": "Text Position",
          "type": "string"
        },
        "waveform_color": {
          "default": "#f3cc8a",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Waveform Color",
          "type": "string"
        },
        "waveform_frame": {
          "default": "glass",
          "enum": [
            "none",
            "glass",
            "outline",
            "accent"
          ],
          "title": "Waveform Frame",
          "type": "string"
        },
        "waveform_glow": {
          "default": 0.58,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Waveform Glow",
          "type": "number"
        },
        "waveform_height_percent": {
          "default": 30,
          "maximum": 60,
          "minimum": 10,
          "title": "Waveform Height Percent",
          "type": "integer"
        },
        "waveform_opacity": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.1,
          "title": "Waveform Opacity",
          "type": "number"
        },
        "waveform_position": {
          "default": "center",
          "enum": [
            "top",
            "center",
            "bottom"
          ],
          "title": "Waveform Position",
          "type": "string"
        },
        "waveform_scale": {
          "default": "sqrt",
          "enum": [
            "linear",
            "sqrt",
            "cbrt",
            "log"
          ],
          "title": "Waveform Scale",
          "type": "string"
        },
        "waveform_style": {
          "default": "mirrored",
          "enum": [
            "line",
            "mirrored",
            "bars",
            "dots",
            "spectrum",
            "spectrum_dots"
          ],
          "title": "Waveform Style",
          "type": "string"
        },
        "waveform_width_percent": {
          "default": 84,
          "maximum": 100,
          "minimum": 40,
          "title": "Waveform Width Percent",
          "type": "integer"
        }
      },
      "title": "AudiogramSettings",
      "type": "object"
    },
    "CleanupSettings": {
      "additionalProperties": false,
      "description": "Deterministic spoken-word cleanup controls admitted for the V1 beta.",
      "properties": {
        "compression": {
          "default": "off",
          "enum": [
            "off",
            "gentle",
            "balanced",
            "firm"
          ],
          "title": "Compression",
          "type": "string"
        },
        "declip": {
          "default": false,
          "title": "Declip",
          "type": "boolean"
        },
        "deesser": {
          "default": "off",
          "enum": [
            "off",
            "light",
            "balanced",
            "strong"
          ],
          "title": "Deesser",
          "type": "string"
        },
        "hum_reduction": {
          "default": "off",
          "enum": [
            "off",
            "50hz",
            "60hz"
          ],
          "title": "Hum Reduction",
          "type": "string"
        },
        "mode": {
          "default": "manual",
          "enum": [
            "smart",
            "manual"
          ],
          "title": "Mode",
          "type": "string"
        },
        "noise_gate": {
          "default": "off",
          "enum": [
            "off",
            "light",
            "balanced"
          ],
          "title": "Noise Gate",
          "type": "string"
        },
        "noise_reduction": {
          "default": "off",
          "enum": [
            "off",
            "light",
            "balanced",
            "strong"
          ],
          "title": "Noise Reduction",
          "type": "string"
        },
        "rumble_filter": {
          "default": false,
          "title": "Rumble Filter",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "voice_enhancement": {
          "default": "off",
          "enum": [
            "off",
            "natural",
            "warm",
            "presence"
          ],
          "title": "Voice Enhancement",
          "type": "string"
        }
      },
      "title": "CleanupSettings",
      "type": "object"
    },
    "ExportSettings": {
      "additionalProperties": false,
      "description": "Delivery choices that map directly to admitted encoder paths.",
      "properties": {
        "mp3": {
          "default": true,
          "title": "Mp3",
          "type": "boolean"
        },
        "mp3_bitrate_kbps": {
          "default": 192,
          "enum": [
            128,
            160,
            192,
            256,
            320
          ],
          "title": "Mp3 Bitrate Kbps",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "wav": {
          "default": true,
          "title": "Wav",
          "type": "boolean"
        }
      },
      "title": "ExportSettings",
      "type": "object"
    },
    "MasteringSettings": {
      "additionalProperties": false,
      "description": "Safe, executable mastering controls exposed by the private beta.",
      "properties": {
        "max_true_peak_dbtp": {
          "maximum": -1.0,
          "minimum": -3.0,
          "title": "Max True Peak Dbtp",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_integrated_lufs": {
          "maximum": -14.0,
          "minimum": -24.0,
          "title": "Target Integrated Lufs",
          "type": "number"
        },
        "target_loudness_range_lu": {
          "maximum": 30.0,
          "minimum": 5.0,
          "title": "Target Loudness Range Lu",
          "type": "number"
        }
      },
      "required": [
        "target_integrated_lufs",
        "max_true_peak_dbtp",
        "target_loudness_range_lu"
      ],
      "title": "MasteringSettings",
      "type": "object"
    },
    "OutputMetadataSettings": {
      "additionalProperties": false,
      "description": "Portable delivery tags written by FFmpeg without adding a metadata dependency.",
      "properties": {
        "album": {
          "default": "",
          "maxLength": 160,
          "title": "Album",
          "type": "string"
        },
        "artist": {
          "default": "",
          "maxLength": 160,
          "title": "Artist",
          "type": "string"
        },
        "comment": {
          "default": "",
          "maxLength": 512,
          "title": "Comment",
          "type": "string"
        },
        "copyright": {
          "default": "",
          "maxLength": 256,
          "title": "Copyright",
          "type": "string"
        },
        "date": {
          "default": "",
          "maxLength": 40,
          "title": "Date",
          "type": "string"
        },
        "genre": {
          "default": "",
          "maxLength": 80,
          "title": "Genre",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "track_number": {
          "default": "",
          "maxLength": 32,
          "title": "Track Number",
          "type": "string"
        }
      },
      "title": "OutputMetadataSettings",
      "type": "object"
    },
    "ProductionSettings": {
      "additionalProperties": false,
      "description": "Complete executable settings for one beta production.",
      "properties": {
        "audiogram": {
          "$ref": "#/$defs/AudiogramSettings"
        },
        "cleanup": {
          "$ref": "#/$defs/CleanupSettings"
        },
        "export": {
          "$ref": "#/$defs/ExportSettings"
        },
        "mastering": {
          "$ref": "#/$defs/MasteringSettings"
        },
        "metadata": {
          "$ref": "#/$defs/OutputMetadataSettings"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "mastering",
        "export"
      ],
      "title": "ProductionSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable template version containing a complete settings value.",
  "properties": {
    "built_in": {
      "default": false,
      "title": "Built In",
      "type": "boolean"
    },
    "change_summary": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Change Summary",
      "type": "string"
    },
    "recipe_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Recipe Version Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "settings": {
      "$ref": "#/$defs/ProductionSettings"
    },
    "settings_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Settings Sha256",
      "type": "string"
    },
    "template_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Template Id",
      "type": "string"
    },
    "template_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Template Version Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "template_version_id",
    "template_id",
    "version",
    "recipe_version_id",
    "settings",
    "settings_sha256",
    "change_summary"
  ],
  "title": "StudioTemplateVersion",
  "type": "object"
}
