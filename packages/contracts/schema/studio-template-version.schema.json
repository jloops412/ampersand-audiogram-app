{
  "$defs": {
    "AudiogramSettings": {
      "additionalProperties": false,
      "description": "Deterministic server-rendered audiogram controls for the V1 beta.",
      "properties": {
        "aspect_ratio": {
          "default": "square",
          "enum": [
            "square",
            "portrait",
            "landscape"
          ],
          "title": "Aspect Ratio",
          "type": "string"
        },
        "background_color": {
          "default": "#111718",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Background Color",
          "type": "string"
        },
        "background_mode": {
          "default": "color",
          "enum": [
            "color",
            "artwork"
          ],
          "title": "Background Mode",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "headline": {
          "default": "",
          "maxLength": 160,
          "title": "Headline",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "subtitle": {
          "default": "",
          "maxLength": 160,
          "title": "Subtitle",
          "type": "string"
        },
        "text_color": {
          "default": "#f4f1ea",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Text Color",
          "type": "string"
        },
        "waveform_color": {
          "default": "#e1b977",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Waveform Color",
          "type": "string"
        },
        "waveform_style": {
          "default": "mirrored",
          "enum": [
            "line",
            "mirrored",
            "bars"
          ],
          "title": "Waveform Style",
          "type": "string"
        }
      },
      "title": "AudiogramSettings",
      "type": "object"
    },
    "CleanupSettings": {
      "additionalProperties": false,
      "description": "Deterministic spoken-word cleanup controls admitted for the V1 beta.",
      "properties": {
        "compression": {
          "default": "balanced",
          "enum": [
            "off",
            "gentle",
            "balanced",
            "firm"
          ],
          "title": "Compression",
          "type": "string"
        },
        "noise_reduction": {
          "default": "balanced",
          "enum": [
            "off",
            "light",
            "balanced",
            "strong"
          ],
          "title": "Noise Reduction",
          "type": "string"
        },
        "rumble_filter": {
          "default": true,
          "title": "Rumble Filter",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "CleanupSettings",
      "type": "object"
    },
    "ExportSettings": {
      "additionalProperties": false,
      "description": "Delivery choices that map directly to admitted encoder paths.",
      "properties": {
        "mp3": {
          "default": true,
          "title": "Mp3",
          "type": "boolean"
        },
        "mp3_bitrate_kbps": {
          "default": 192,
          "enum": [
            128,
            160,
            192,
            256,
            320
          ],
          "title": "Mp3 Bitrate Kbps",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "wav": {
          "default": true,
          "title": "Wav",
          "type": "boolean"
        }
      },
      "title": "ExportSettings",
      "type": "object"
    },
    "MasteringSettings": {
      "additionalProperties": false,
      "description": "Safe, executable mastering controls exposed by the private beta.",
      "properties": {
        "max_true_peak_dbtp": {
          "maximum": -1.0,
          "minimum": -3.0,
          "title": "Max True Peak Dbtp",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_integrated_lufs": {
          "maximum": -14.0,
          "minimum": -24.0,
          "title": "Target Integrated Lufs",
          "type": "number"
        },
        "target_loudness_range_lu": {
          "maximum": 30.0,
          "minimum": 5.0,
          "title": "Target Loudness Range Lu",
          "type": "number"
        }
      },
      "required": [
        "target_integrated_lufs",
        "max_true_peak_dbtp",
        "target_loudness_range_lu"
      ],
      "title": "MasteringSettings",
      "type": "object"
    },
    "OutputMetadataSettings": {
      "additionalProperties": false,
      "description": "Portable delivery tags written by FFmpeg without adding a metadata dependency.",
      "properties": {
        "album": {
          "default": "",
          "maxLength": 160,
          "title": "Album",
          "type": "string"
        },
        "artist": {
          "default": "",
          "maxLength": 160,
          "title": "Artist",
          "type": "string"
        },
        "comment": {
          "default": "",
          "maxLength": 512,
          "title": "Comment",
          "type": "string"
        },
        "copyright": {
          "default": "",
          "maxLength": 256,
          "title": "Copyright",
          "type": "string"
        },
        "date": {
          "default": "",
          "maxLength": 40,
          "title": "Date",
          "type": "string"
        },
        "genre": {
          "default": "",
          "maxLength": 80,
          "title": "Genre",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "track_number": {
          "default": "",
          "maxLength": 32,
          "title": "Track Number",
          "type": "string"
        }
      },
      "title": "OutputMetadataSettings",
      "type": "object"
    },
    "ProductionSettings": {
      "additionalProperties": false,
      "description": "Complete executable settings for one beta production.",
      "properties": {
        "audiogram": {
          "$ref": "#/$defs/AudiogramSettings"
        },
        "cleanup": {
          "$ref": "#/$defs/CleanupSettings"
        },
        "export": {
          "$ref": "#/$defs/ExportSettings"
        },
        "mastering": {
          "$ref": "#/$defs/MasteringSettings"
        },
        "metadata": {
          "$ref": "#/$defs/OutputMetadataSettings"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "mastering",
        "export"
      ],
      "title": "ProductionSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable template version containing a complete settings value.",
  "properties": {
    "built_in": {
      "default": false,
      "title": "Built In",
      "type": "boolean"
    },
    "change_summary": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Change Summary",
      "type": "string"
    },
    "recipe_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Recipe Version Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "settings": {
      "$ref": "#/$defs/ProductionSettings"
    },
    "settings_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Settings Sha256",
      "type": "string"
    },
    "template_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Template Id",
      "type": "string"
    },
    "template_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Template Version Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "template_version_id",
    "template_id",
    "version",
    "recipe_version_id",
    "settings",
    "settings_sha256",
    "change_summary"
  ],
  "title": "StudioTemplateVersion",
  "type": "object"
}
