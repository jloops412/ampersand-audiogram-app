{
  "$defs": {
    "WaveformLevel": {
      "additionalProperties": false,
      "properties": {
        "samples_per_window": {
          "exclusiveMinimum": 0,
          "title": "Samples Per Window",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "windows": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Windows",
          "type": "array"
        }
      },
      "required": [
        "samples_per_window",
        "windows"
      ],
      "title": "WaveformLevel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "channels": {
      "exclusiveMinimum": 0,
      "title": "Channels",
      "type": "integer"
    },
    "duration_us": {
      "minimum": 0,
      "title": "Duration Us",
      "type": "integer"
    },
    "levels": {
      "items": {
        "$ref": "#/$defs/WaveformLevel"
      },
      "title": "Levels",
      "type": "array"
    },
    "sample_rate_hz": {
      "exclusiveMinimum": 0,
      "title": "Sample Rate Hz",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "waveform_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Waveform Id",
      "type": "string"
    }
  },
  "required": [
    "waveform_id",
    "source_asset_id",
    "sample_rate_hz",
    "channels",
    "duration_us",
    "levels"
  ],
  "title": "WaveformPeaks",
  "type": "object"
}
