        },
        "sample_rate_hz": {
          "exclusiveMinimum": 0,
          "maximum": 192000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "short_term_lufs_max": {
          "title": "Short Term Lufs Max",
          "type": "number"
        },
        "short_term_lufs_min": {
          "title": "Short Term Lufs Min",
