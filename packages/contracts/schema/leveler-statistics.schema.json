{
  "$defs": {
    "SignificantGainCorrection": {
      "additionalProperties": false,
      "properties": {
        "correction_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "title": "Correction Id",
          "type": "string"
        },
        "end_us": {
          "minimum": 0,
          "title": "End Us",
          "type": "integer"
        },
        "peak_gain_db": {
          "maximum": 24.0,
          "minimum": -60.0,
          "title": "Peak Gain Db",
          "type": "number"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_us": {
          "minimum": 0,
          "title": "Start Us",
          "type": "integer"
        }
      },
      "required": [
        "correction_id",
        "start_us",
        "end_us",
        "peak_gain_db",
        "reason"
      ],
      "title": "SignificantGainCorrection",
      "type": "object"
    },
    "SpeakerLevelStatistics": {
      "additionalProperties": false,
      "properties": {
        "eligible_duration_us": {
          "minimum": 0,
          "title": "Eligible Duration Us",
          "type": "integer"
        },
        "observation_count": {
          "exclusiveMinimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "relative_offset_db": {
          "title": "Relative Offset Db",
          "type": "number"
        },
        "robust_speech_level_lufs": {
          "title": "Robust Speech Level Lufs",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "speaker_label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Speaker Label",
          "type": "string"
        },
        "used_global_fallback": {
          "title": "Used Global Fallback",
          "type": "boolean"
        }
      },
      "required": [
        "speaker_label",
        "observation_count",
        "eligible_duration_us",
        "robust_speech_level_lufs",
        "relative_offset_db",
        "used_global_fallback"
      ],
      "title": "SpeakerLevelStatistics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activation_mode": {
      "enum": [
        "shadow",
        "active"
      ],
      "title": "Activation Mode",
      "type": "string"
    },
    "algorithm_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Algorithm Version",
      "type": "string"
    },
    "changed_duration_us": {
      "minimum": 0,
      "title": "Changed Duration Us",
      "type": "integer"
    },
    "changed_region_count": {
      "minimum": 0,
      "title": "Changed Region Count",
      "type": "integer"
    },
    "comfort_band_high_lufs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Comfort Band High Lufs"
    },
    "comfort_band_low_lufs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Comfort Band Low Lufs"
    },
    "eligible_duration_us": {
      "minimum": 0,
      "title": "Eligible Duration Us",
      "type": "integer"
    },
    "eligible_region_count": {
      "minimum": 0,
      "title": "Eligible Region Count",
      "type": "integer"
    },
    "gain_max_db": {
      "maximum": 24.0,
      "minimum": -60.0,
      "title": "Gain Max Db",
      "type": "number"
    },
    "gain_mean_db": {
      "maximum": 24.0,
      "minimum": -60.0,
      "title": "Gain Mean Db",
      "type": "number"
    },
    "gain_min_db": {
      "maximum": 24.0,
      "minimum": -60.0,
      "title": "Gain Min Db",
      "type": "number"
    },
    "leveler_statistics_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Leveler Statistics Id",
      "type": "string"
    },
    "maximum_gain_acceleration_db_per_second2": {
      "minimum": 0.0,
      "title": "Maximum Gain Acceleration Db Per Second2",
      "type": "number"
    },
    "maximum_gain_slope_db_per_second": {
      "minimum": 0.0,
      "title": "Maximum Gain Slope Db Per Second",
      "type": "number"
    },
    "peak_limited_region_count": {
      "minimum": 0,
      "title": "Peak Limited Region Count",
      "type": "integer"
    },
    "protected_region_count": {
      "minimum": 0,
      "title": "Protected Region Count",
      "type": "integer"
    },
    "reasoning": {
      "items": {
        "type": "string"
      },
      "title": "Reasoning",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_map_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Semantic Map Id",
      "type": "string"
    },
    "settings_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Settings Id",
      "type": "string"
    },
    "settings_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Settings Sha256",
      "type": "string"
    },
    "significant_corrections": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SignificantGainCorrection"
      },
      "title": "Significant Corrections",
      "type": "array"
    },
    "speaker_statistics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SpeakerLevelStatistics"
      },
      "title": "Speaker Statistics",
      "type": "array"
    },
    "target_speech_level_lufs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Target Speech Level Lufs"
    },
    "total_duration_us": {
      "minimum": 0,
      "title": "Total Duration Us",
      "type": "integer"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "leveler_statistics_id",
    "run_id",
    "semantic_map_id",
    "settings_id",
    "settings_sha256",
    "algorithm_version",
    "activation_mode",
    "target_speech_level_lufs",
    "comfort_band_low_lufs",
    "comfort_band_high_lufs",
    "total_duration_us",
    "eligible_duration_us",
    "changed_duration_us",
    "eligible_region_count",
    "protected_region_count",
    "changed_region_count",
    "gain_min_db",
    "gain_mean_db",
    "gain_max_db",
    "maximum_gain_slope_db_per_second",
    "maximum_gain_acceleration_db_per_second2",
    "peak_limited_region_count",
    "reasoning"
  ],
  "title": "LevelerStatistics",
  "type": "object"
}
