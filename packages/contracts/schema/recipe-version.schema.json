  "required": [
    "recipe_version_id",
    "slug",
    "recipe_version",
    "display_name",
    "description",
    "analysis_steps",
    "processing_steps",
    "target_integrated_lufs",
    "max_true_peak_dbtp",
    "target_loudness_range_lu",
    "output_formats"
