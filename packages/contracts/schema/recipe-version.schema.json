      "default": false,
      "title": "Allows Neural Processing",
      "type": "boolean"
    },
    "analysis_steps": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Analysis Steps",
      "type": "array"
    },
    "dependency_manifest_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Dependency Manifest Ids",
      "type": "array"
    },
    "description": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "display_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "max_true_peak_dbtp": {
      "maximum": 0.0,
      "minimum": -12.0,
      "title": "Max True Peak Dbtp",
      "type": "number"
    },
    "model_manifest_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Model Manifest Ids",
      "type": "array"
    },
    "output_formats": {
      "items": {
        "enum": [
          "wav",
          "mp3"
        ],
        "type": "string"
      },
      "title": "Output Formats",
      "type": "array"
    },
    "preserves_source": {
      "const": true,
      "default": true,
      "title": "Preserves Source",
      "type": "boolean"
    },
    "processing_steps": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Processing Steps",
      "type": "array"
    },
    "recipe_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Recipe Version",
      "type": "string"
    },
    "recipe_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Recipe Version Id",
      "type": "string"
