{
  "additionalProperties": false,
  "properties": {
    "evaluation_prompt": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Evaluation Prompt",
      "type": "string"
    },
    "item_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Item Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segment_end_us": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Segment End Us"
    },
    "segment_start_us": {
      "minimum": 0,
      "title": "Segment Start Us",
      "type": "integer"
    },
    "source_fixture_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Source Fixture Id",
      "type": "string"
    },
    "source_region_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Source Region Ids",
      "type": "array"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "trial_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Trial Id",
      "type": "string"
    }
  },
  "required": [
    "trial_id",
    "item_id",
    "source_fixture_id",
    "source_sha256",
    "segment_start_us",
    "evaluation_prompt"
  ],
  "title": "ListeningItemReveal",
  "type": "object"
}
