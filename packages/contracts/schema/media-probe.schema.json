    },
    "codec_name": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Codec Name",
      "type": "string"
    },
    "duration_us": {
      "minimum": 0,
      "title": "Duration Us",
      "type": "integer"
    },
    "ffprobe_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Ffprobe Version",
      "type": "string"
