    "format_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Format Name",
      "type": "string"
    },
    "probe_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Probe Id",
      "type": "string"
