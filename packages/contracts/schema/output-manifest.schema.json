{
  "$defs": {
    "AssetKind": {
      "enum": [
        "source",
        "background_artwork",
        "canonical_audio",
        "waveform",
        "master_wav",
        "master_mp3",
        "audiogram_mp4",
        "manifest"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "LoudnessMeasurement": {
      "additionalProperties": false,
      "properties": {
        "backend_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Backend Version",
          "type": "string"
        },
        "integrated_lufs": {
          "title": "Integrated Lufs",
          "type": "number"
        },
        "loudness_range_lu": {
          "minimum": 0.0,
          "title": "Loudness Range Lu",
          "type": "number"
        },
        "measurement_backend": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Measurement Backend",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "threshold_lufs": {
          "title": "Threshold Lufs",
          "type": "number"
        },
        "true_peak_dbtp": {
          "title": "True Peak Dbtp",
          "type": "number"
        }
      },
      "required": [
        "integrated_lufs",
        "true_peak_dbtp",
        "loudness_range_lu",
        "threshold_lufs",
        "measurement_backend",
        "backend_version"
      ],
      "title": "LoudnessMeasurement",
      "type": "object"
    },
    "OutputArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "duration_us": {
          "minimum": 0,
          "title": "Duration Us",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "mime_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "validation_notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Validation Notes",
          "type": "array"
        },
        "validation_status": {
          "enum": [
            "valid",
            "warning",
            "invalid"
          ],
          "title": "Validation Status",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "relative_path",
        "sha256",
        "size_bytes",
        "mime_type",
        "duration_us",
        "validation_status"
      ],
      "title": "OutputArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/OutputArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "loudness_after": {
      "$ref": "#/$defs/LoudnessMeasurement"
    },
    "max_true_peak_dbtp": {
      "title": "Max True Peak Dbtp",
      "type": "number"
    },
    "output_manifest_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Output Manifest Id",
      "type": "string"
    },
    "recipe_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Recipe Version Id",
      "type": "string"
    },
    "resolved_settings_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Resolved Settings Id",
      "type": "string"
    },
    "resolved_settings_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resolved Settings Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "target_integrated_lufs": {
      "title": "Target Integrated Lufs",
      "type": "number"
    },
    "validation_status": {
      "enum": [
        "valid",
        "warning",
        "invalid"
      ],
      "title": "Validation Status",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "output_manifest_id",
    "run_id",
    "source_asset_id",
    "recipe_version_id",
    "resolved_settings_id",
    "resolved_settings_sha256",
    "artifacts",
    "loudness_after",
    "target_integrated_lufs",
    "max_true_peak_dbtp",
    "validation_status"
  ],
  "title": "OutputManifest",
  "type": "object"
}
