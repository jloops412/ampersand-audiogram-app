{
  "$defs": {
    "RunStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "engine_build_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Engine Build Id",
      "type": "string"
    },
    "idempotency_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "production_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Production Id",
      "type": "string"
    },
    "recipe_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Recipe Version Id",
      "type": "string"
    },
    "resolved_settings_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Resolved Settings Id",
      "type": "string"
    },
    "resolved_settings_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resolved Settings Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "step_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Step Ids",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "production_id",
    "recipe_version_id",
    "resolved_settings_id",
    "resolved_settings_sha256",
    "engine_build_id",
    "idempotency_key",
    "status",
    "step_ids"
  ],
  "title": "ProductionRun",
  "type": "object"
}
