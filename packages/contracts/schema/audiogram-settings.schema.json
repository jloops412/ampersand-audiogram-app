{
  "additionalProperties": false,
  "description": "Versioned deterministic controls shared by Studio and the server renderer.",
  "properties": {
    "accent_color": {
      "default": "#e1b977",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "title": "Accent Color",
      "type": "string"
    },
    "aspect_ratio": {
      "default": "square",
      "enum": [
        "square",
        "feed_portrait",
        "portrait",
        "landscape"
      ],
      "title": "Aspect Ratio",
      "type": "string"
    },
    "background_blur": {
      "default": 0,
      "maximum": 30,
      "minimum": 0,
      "title": "Background Blur",
      "type": "integer"
    },
    "background_color": {
      "default": "#111718",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "title": "Background Color",
      "type": "string"
    },
    "background_dim": {
      "default": 0.08,
      "maximum": 0.85,
      "minimum": 0.0,
      "title": "Background Dim",
      "type": "number"
    },
    "background_fit": {
      "default": "cover",
      "enum": [
        "cover",
        "contain"
      ],
      "title": "Background Fit",
      "type": "string"
    },
    "background_mode": {
      "default": "gradient",
      "enum": [
        "color",
        "gradient",
        "radial",
        "artwork",
        "video"
      ],
      "title": "Background Mode",
      "type": "string"
    },
    "background_vignette": {
      "default": 0.45,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Background Vignette",
      "type": "number"
    },
    "enabled": {
      "default": false,
      "title": "Enabled",
      "type": "boolean"
    },
    "font_family": {
      "default": "sans",
      "enum": [
        "sans",
        "serif",
        "mono"
      ],
      "title": "Font Family",
      "type": "string"
    },
    "frame_rate": {
      "default": 30,
      "enum": [
        24,
        30,
        60
      ],
      "title": "Frame Rate",
      "type": "integer"
    },
    "headline": {
      "default": "",
      "maxLength": 160,
      "title": "Headline",
      "type": "string"
    },
    "headline_size_percent": {
      "default": 4.8,
      "maximum": 10.0,
      "minimum": 2.0,
      "title": "Headline Size Percent",
      "type": "number"
    },
    "render_quality": {
      "default": "standard",
      "enum": [
        "draft",
        "standard",
        "high"
      ],
      "title": "Render Quality",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "spec_version": {
      "default": "1.1",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Spec Version",
      "type": "string"
    },
    "subtitle": {
      "default": "",
      "maxLength": 160,
      "title": "Subtitle",
      "type": "string"
    },
    "subtitle_size_percent": {
      "default": 2.7,
      "maximum": 6.0,
      "minimum": 1.0,
      "title": "Subtitle Size Percent",
      "type": "number"
    },
    "text_align": {
      "default": "center",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "title": "Text Align",
      "type": "string"
    },
    "text_color": {
      "default": "#f8f4ec",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "title": "Text Color",
      "type": "string"
    },
    "text_panel": {
      "default": "shadow",
      "enum": [
        "none",
        "shadow",
        "glass",
        "accent"
      ],
      "title": "Text Panel",
      "type": "string"
    },
    "text_position": {
      "default": "top",
      "enum": [
        "top",
        "center",
        "bottom"
      ],
      "title": "Text Position",
      "type": "string"
    },
    "waveform_color": {
      "default": "#f3cc8a",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "title": "Waveform Color",
      "type": "string"
    },
    "waveform_frame": {
      "default": "glass",
      "enum": [
        "none",
        "glass",
        "outline",
        "accent"
      ],
      "title": "Waveform Frame",
      "type": "string"
    },
    "waveform_glow": {
      "default": 0.58,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Waveform Glow",
      "type": "number"
    },
    "waveform_height_percent": {
      "default": 30,
      "maximum": 60,
      "minimum": 10,
      "title": "Waveform Height Percent",
      "type": "integer"
    },
    "waveform_opacity": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.1,
      "title": "Waveform Opacity",
      "type": "number"
    },
    "waveform_position": {
      "default": "center",
      "enum": [
        "top",
        "center",
        "bottom"
      ],
      "title": "Waveform Position",
      "type": "string"
    },
    "waveform_scale": {
      "default": "sqrt",
      "enum": [
        "linear",
        "sqrt",
        "cbrt",
        "log"
      ],
      "title": "Waveform Scale",
      "type": "string"
    },
    "waveform_style": {
      "default": "mirrored",
      "enum": [
        "line",
        "mirrored",
        "bars",
        "dots",
        "spectrum",
        "spectrum_dots"
      ],
      "title": "Waveform Style",
      "type": "string"
    },
    "waveform_width_percent": {
      "default": 84,
      "maximum": 100,
      "minimum": 40,
      "title": "Waveform Width Percent",
      "type": "integer"
    }
  },
  "title": "AudiogramSettings",
  "type": "object"
}
