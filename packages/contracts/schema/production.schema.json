{
  "$defs": {
    "RunStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "current_run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Current Run Id",
      "type": "string"
    },
    "production_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Production Id",
      "type": "string"
    },
    "recipe_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Recipe Version Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "production_id",
    "workspace_id",
    "title",
    "source_asset_id",
    "recipe_version_id",
    "current_run_id",
    "status"
  ],
  "title": "Production",
  "type": "object"
}
