{
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "bypass",
        "protect",
        "deterministic_filter",
        "denoise",
        "level",
        "final_master"
      ],
      "title": "Action",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "decision_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Decision Id",
      "type": "string"
    },
    "fallback_processor_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Processor Id"
    },
    "parameters": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Parameters",
      "type": "object"
    },
    "planning_only": {
      "const": true,
      "default": true,
      "title": "Planning Only",
      "type": "boolean"
    },
    "processing_region_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Processing Region Id",
      "type": "string"
    },
    "processor_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Processor Id",
      "type": "string"
    },
    "reason": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "reason_code": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
      "title": "Reason Code",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_region_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Semantic Region Ids",
      "type": "array"
    },
    "warning_codes": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$",
        "type": "string"
      },
      "title": "Warning Codes",
      "type": "array"
    }
  },
  "required": [
    "decision_id",
    "processing_region_id",
    "semantic_region_ids",
    "action",
    "processor_id",
    "reason_code",
    "reason",
    "confidence"
  ],
  "title": "ProcessingRouteDecision",
  "type": "object"
}
