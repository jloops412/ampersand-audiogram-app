{
  "name": "ampersand-studio-beta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview",
    "beta:start": "node apps/worker-control/server.js",
    "beta:test": "node --test apps/worker-control/*.test.js",
    "beta:check": "node --check apps/worker-control/server.js && node --check apps/worker-control/storage.js && node --check apps/worker-control/gcs.js",
    "web:test": "tsc -p apps/web/tsconfig.waveform-test.json && node --test apps/web/tests/*.test.mjs",
    "edit-core:test": "tsc -p packages/edit-core/tsconfig.json && node --test packages/edit-core/tests/*.test.mjs",
    "legacy:dev": "vite --config vite.config.ts",
    "legacy:build": "tsc && vite build",
    "v2:sync": "uv sync --all-packages --dev",
    "v2:check": "uv run python scripts/check_v2_boundaries.py && uv run ruff check packages services scripts && uv run ruff format --check packages services scripts && uv run mypy && uv run pytest",
    "v2:process": "uv run --package ampersand-media-worker ampersand-engine process"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "wavesurfer.js": "7.12.11"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
