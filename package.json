{
  "name": "ampersand-legacy-audiogram",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "legacy:dev": "vite",
    "legacy:build": "tsc && vite build",
    "v2:sync": "uv sync --all-packages --dev",
    "v2:check": "uv run python scripts/check_v2_boundaries.py && uv run ruff check packages services scripts && uv run ruff format --check packages services scripts && uv run mypy && uv run pytest",
    "v2:process": "uv run --package ampersand-media-worker ampersand-engine process"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
